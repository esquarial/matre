#!/bin/bash

# Pre-Commit Hook for Code Quality
# Automatically enabled via composer install/update (sets core.hooksPath to .githooks)

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}   Running Pre-Commit Quality Checks${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get list of staged PHP files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep ".php$")

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}No PHP files to check${NC}"
    exit 0
fi

echo -e "${BLUE}Files to check:${NC}"
echo "$STAGED_FILES"
echo ""

# Detect Docker — host PHP version may not match composer requirements
DOCKER_PHP=""
if docker compose ps --status running 2>/dev/null | grep -q "php"; then
    DOCKER_PHP="docker compose exec -T php"
fi

# Check 1: PHP Syntax Check
echo -e "${BLUE}[1/4] PHP Syntax Check...${NC}"
SYNTAX_ERROR=0
for FILE in $STAGED_FILES; do
    php -l "$FILE" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo -e "${RED}✗ Syntax error in: $FILE${NC}"
        php -l "$FILE"
        SYNTAX_ERROR=1
    fi
done

if [ $SYNTAX_ERROR -eq 1 ]; then
    echo -e "${RED}✗ Syntax check failed${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Syntax check passed${NC}"
echo ""

# Check 2: PHP-CS-Fixer (run inside Docker to avoid host PHP version mismatch)
echo -e "${BLUE}[2/4] Code Style Check (PHP-CS-Fixer)...${NC}"
if [ -n "$DOCKER_PHP" ]; then
    $DOCKER_PHP vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff $(echo "$STAGED_FILES" | tr '\n' ' ')
    if [ $? -ne 0 ]; then
        echo -e "${YELLOW}⚠ Code style issues found${NC}"
        echo -e "${YELLOW}Run './local.sh fix' to auto-fix${NC}"

        # Ask if user wants to auto-fix
        read -p "Auto-fix code style issues? (y/n) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            $DOCKER_PHP vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php $(echo "$STAGED_FILES" | tr '\n' ' ')
            # Re-stage fixed files
            git add $STAGED_FILES
            echo -e "${GREEN}✓ Code style fixed and files re-staged${NC}"
        else
            echo -e "${RED}✗ Code style check failed${NC}"
            exit 1
        fi
    else
        echo -e "${GREEN}✓ Code style check passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠ Docker not running (skipping CS check)${NC}"
fi
echo ""

# Check 3: PHPStan (only on changed files, inside Docker)
echo -e "${BLUE}[3/4] Static Analysis (PHPStan)...${NC}"
if [ -n "$DOCKER_PHP" ]; then
    $DOCKER_PHP vendor/bin/phpstan analyse --memory-limit=512M --no-progress --error-format=table $(echo "$STAGED_FILES" | tr '\n' ' ')
    if [ $? -ne 0 ]; then
        echo -e "${RED}✗ PHPStan found issues${NC}"
        echo -e "${YELLOW}Fix issues or use 'git commit --no-verify' to skip${NC}"
        exit 1
    else
        echo -e "${GREEN}✓ Static analysis passed${NC}"
    fi
else
    echo -e "${YELLOW}⚠ Docker not running (skipping PHPStan)${NC}"
fi
echo ""

# Check 4: Run Tests (optional, can be slow)
# Uncomment to enable test running on commit
# echo -e "${BLUE}[4/4] Running Tests...${NC}"
# if [ -f "vendor/bin/phpunit" ]; then
#     vendor/bin/phpunit --testsuite unit
#     if [ $? -ne 0 ]; then
#         echo -e "${RED}✗ Tests failed${NC}"
#         exit 1
#     fi
#     echo -e "${GREEN}✓ Tests passed${NC}"
# else
#     echo -e "${YELLOW}⚠ PHPUnit not installed (skipping)${NC}"
# fi
# echo ""

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}   ✓ All Pre-Commit Checks Passed!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 0
